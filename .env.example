# Project VECTOR local configuration. Dummy values only; never commit secrets.
VECTOR_ENV=development
VECTOR_LOG_LEVEL=info
VECTOR_DATA_DIR=./vector-data
VECTOR_DB_URL=sqlite://./vector-data/vector.db
VECTOR_CONTENT_DIR=./content/packs
VECTOR_TELEMETRY_MODE=local_only
VECTOR_CRASH_CONSENT=ask
VECTOR_CRASH_REDACTION=strict
VECTOR_LLM_DEFAULT=local
VECTOR_LLM_LOCAL_ENDPOINT=http://127.0.0.1:8080
VECTOR_LLM_LOCAL_MODEL=Qwen3.5-9B-GGUF-user-provided
VECTOR_NATIVE_XAI_CLI=grok
VECTOR_NATIVE_CODEX_CLI=codex
VECTOR_NATIVE_CLAUDE_CLI=claude
VECTOR_NATIVE_TRANSPORT_TIMEOUT_SECONDS=120
VECTOR_ALLOW_XAI_NATIVE=true
VECTOR_ALLOW_CODEX_NATIVE=true
VECTOR_ALLOW_CLAUDE_NATIVE=terms_gate
VECTOR_ALLOW_GEMINI_CLI_OAUTH=false
VECTOR_ALLOW_PROVIDER_APIS=false
VECTOR_GEMINI_NOTEBOOK_ENTERPRISE=false
VECTOR_MCP_LISTEN=127.0.0.1:7317
VECTOR_MCP_AUTH_MODE=local_capability_token
VECTOR_REPAIR_BROKER_ENABLED=false
VECTOR_REPAIR_AGENT=codex
VECTOR_GITHUB_PR_ENABLED=false
VECTOR_GITHUB_REPO=owner/project-vector
VECTOR_GH_CLI=gh
VECTOR_UPDATE_CHANNEL=stable
VECTOR_CONTENT_SIGNING_PUBLIC_KEY=development-key-replace-before-release
VECTOR_SENTRY_DSN=
VECTOR_OTLP_ENDPOINT=
VECTOR_AUTO_DEPLOY=false
