.env
.env.*
!.env.example
node_modules/
target/
dist/
build/
coverage/
playwright-report/
test-results/
*.log

# Gate logs are ignored because they are large, machine-specific, and rewritten
# on every run. They are not discarded, though: each closed epoch keeps an
# immutable `.agent/evidence/EP-XXX/logs.tar.gz`, so the committed `.log.sha256`
# digests stay re-derivable from a clean clone. Prove it with
# `python3 scripts/verify-evidence-archive.py`.
*.dmp
*.crash
*.tmp
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
vector-data/
repair-worktrees/
release-artifacts/

# Runtime SQLite state. This is the learner's data store, not source: committing
# it would carry one learner's history into every clone. Found tracked during the
# EP-010 secret scan.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local configuration written by third-party developer tools (for example a
# Serena MCP server started by a provider CLI). These are per-machine tool
# settings, not product source, and committing them would put one developer's
# editor configuration into every clone.
.serena/

# Python bytecode caches. Generated by importing or compiling the scripts.
__pycache__/
*.pyc
